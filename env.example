# CHOST Panel: optional Railway Variables. Nothing here is required.
# First login: admin / admin (first boot only). Change it right away from the sidebar page "Account security".

# Subscription title shown in the apps
CONFIG_TITLE=CHOST

# Subscription path: https://YOUR-DOMAIN/<SUBSCRIPTION_PATH>/<token>
SUBSCRIPTION_PATH=sub

# Demo reseller (reseller / reseller, 50 GB). Set to off to skip it
DEMO_RESELLER=on

# Users saved without a group get both CHOST groups (all 6 configs), so no subscription is ever empty.
# off = never touch users
AUTO_GROUP=on

# Port of the service (recommended). The domain target port in Settings > Networking must be the same
PORT=8080
