user www-data;
worker_processes auto;
worker_rlimit_nofile 65535;
pid /run/nginx.pid;
events { worker_connections 4096; multi_accept on; use epoll; }
http {
  access_log off;
  error_log /dev/stderr warn;
  sendfile on; tcp_nodelay on; tcp_nopush off; keepalive_timeout 75s; keepalive_requests 10000;
  server_tokens off;
  client_max_body_size 0;
  map $http_upgrade $conn_upgrade { default upgrade; '' ''; }

  # performance: reuse connections to the panel, compress panel assets
  upstream panel { server 127.0.0.1:8000; keepalive 32; }
  gzip on; gzip_comp_level 5; gzip_min_length 1024; gzip_proxied any;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  server {
    # IPv4 + IPv6: some Railway regions (Metal) send health checks and traffic over IPv6
    listen __PORT__ default_server;
    listen [::]:__PORT__ default_server;
    #__EXTRA_LISTEN__

    location = /healthz { return 200 "ok"; }

    # opening the bare domain goes straight to the panel (relative redirect: keeps https behind Railway)
    absolute_redirect off;
    location = / { return 302 /dashboard/; }

    # while the panel is still starting (first boot, update), show a calm page that refreshes itself
    # instead of a raw 502 error
    error_page 502 504 =503 /chost-wait.html;
    error_page 503 /chost-wait.html;
    location = /chost-wait.html { root /etc/nginx; internal; default_type text/html; charset utf-8; add_header Cache-Control "no-store" always; add_header Retry-After 6 always; }

    # ---- 6 config paths: random per install, generated by genpaths.py on first boot ----
    include /var/lib/pasarguard/inbounds.inc;

    # ---- CHOST service: owner key, password, reseller panel and Telegram bot API ----
    location ^~ /chost/ {
      proxy_pass http://127.0.0.1:8100;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Host $host;
    }

    # ---- CHOST dashboard menu filter ----
    location = /chost-ui.js { alias /etc/nginx/chost-ui.js; default_type application/javascript; charset utf-8; charset_types application/javascript; add_header Cache-Control "no-cache"; }
    location /dashboard {
      # first boot only: wait until admin/admin is ready, so the very first login always works
      if (-f /run/chost-starting) { return 503; }
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
      proxy_set_header Accept-Encoding "";
      sub_filter_types text/html;
      sub_filter_once on;
      sub_filter '</head>' '<script src="/chost-ui.js" defer></script></head>';
    }

    # ---- panel / api / subscription ----
    location / {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $conn_upgrade;
      proxy_read_timeout 300s;
    }
  }
}
